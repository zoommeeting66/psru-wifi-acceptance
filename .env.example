NODE_ENV=development
PORT=3200
TZ=Asia/Bangkok

# Replace <user> and <password> with your local PostgreSQL credentials.
# Never commit the filled-in .env — it is gitignored for that reason.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/psru_wifi
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/psru_wifi_test

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
